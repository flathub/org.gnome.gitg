{
    "app-id": "org.gnome.gitg",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "gitg",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=ssh-auth",
        "--share=network",
        "--filesystem=host",
        "--talk-name=org.freedesktop.secrets",
        "--filesystem=xdg-run/keyring"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/aclocal",
        "/share/doc",
        "/share/gir-1.0",
        "/share/glade",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/vala",
        "*.a",
        "*.la",
        "*.pyc",
        "__pycache__"
    ],
    "modules": [
        {
            "name": "gtksourceview4",
            "buildsystem": "meson",
            "config-opts": [
                "-Dinstall_tests=false",
                "-Dgtk_doc=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gtksourceview/4.8/gtksourceview-4.8.4.tar.xz",
                    "sha256": "7ec9d18fb283d1f84a3a3eff3b7a72b09a10c9c006597b3fbabbb5958420a87d"
                }
            ],
            "cleanup": [
                "/include",
                "/lib/pkgconfig"
            ]
        },
        {
            "name": "libssh2",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.libssh2.org/download/libssh2-1.11.1.tar.gz",
                    "sha256": "d9ec76cbe34db98eec3539fe2c899d26b0c837cb3eb466a56b0f109cabf658f7",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1730,
                        "url-template": "https://www.libssh2.org/download/libssh2-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "libgit2",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS:BOOL=ON",
                "-DBUILD_TESTS:BOOL=OFF",
                "-DUSE_THREADS:BOOL=ON",
                "-DUSE_SSH:BOOL=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libgit2/libgit2/archive/v1.7.2/libgit2-1.7.2.tar.gz",
                    "sha256": "de384e29d7efc9330c6cdb126ebf88342b5025d920dcb7c645defad85195ea7f",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1627,
                        "versions": {
                            "<": "1.8.0"
                        },
                        "url-template": "https://github.com/libgit2/libgit2/archive/v$version/libgit2-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "libgit2-glib",
            "config-opts": [
                "--buildtype=debugoptimized"
            ],
            "buildsystem": "meson",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libgit2-glib/1.2/libgit2-glib-1.2.1.tar.xz",
                    "sha256": "97423a779002b3be8751c75f9d79049dfccca3616a26159fc162486772ba785f",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "libgit2-glib"
                    }
                }
            ]
        },
        "shared-modules/intltool/intltool-0.51.json",
        {
            "name": "libpeas",
            "cleanup": [
                "/bin/*",
                "/lib/peas-demo"
            ],
            "buildsystem": "meson",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libpeas/1.38/libpeas-1.38.1.tar.xz",
                    "sha256": "e82fd328adcac1aba34b64136bdfcbbacf2b3258a8bc4e5f480a72502a611ae9",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "libpeas",
                        "versions": {
                            "<": "1.99"
                        }
                    }
                }
            ]
        },
        {
            "name": "enchant",
            "cleanup": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/AbiWord/enchant/releases/download/v2.8.16/enchant-2.8.16.tar.gz",
                    "sha256": "d73162b5eff401a6397e1215e2b103bcef83f921c396c7f6b1394d2450d124e2",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 6601,
                        "url-template": "https://github.com/AbiWord/enchant/releases/download/v$version/enchant-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "gspell",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gspell/1.14/gspell-1.14.4.tar.xz",
                    "sha256": "e73a89d68c70f8748aefb6b0f5cfdfec3ff173cf4449837fd6cb17d1e9fcf486",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "gspell"
                    }
                }
            ],
            "cleanup": [
                "/bin"
            ]
        },
        {
            "name": "git",
            "make-args": [
                "NO_TCLTK=1",
                "INSTALL_SYMLINKS=1"
            ],
            "make-install-args": [
                "NO_TCLTK=1",
                "INSTALL_SYMLINKS=1"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.54.0.tar.xz",
                    "sha256": "f689162364c10de79ef89aa8dbf48731eb057e34edbbd20aca510ce0154681a3",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5350,
                        "stable-only": true,
                        "url-template": "https://mirrors.edge.kernel.org/pub/software/scm/git/git-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "gitg",
            "buildsystem": "meson",
            "cleanup": [
                "/bin/python"
            ],
            "config-opts": [
                "--buildtype=debugoptimized",
                "-Ddeprecations=true"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gitg/44/gitg-44.tar.xz",
                    "sha256": "342a31684dab9671cd341bd3e3ce665adcee0460c2a081ddc493cdbc03132530",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "gnome",
                        "name": "gitg"
                    }
                },
                {
                    "type": "patch",
                    "paths": [
                        "patches/0001-Remove-libdazzle-dependency.patch",
                        "patches/0002-fix-format-not-string-literal.patch",
                        "patches/0003-error-format-expects-argument-type.patch",
                        "patches/0004-fix-zero-length-printf-format-string.patch",
                        "patches/0005-libpeas-1.38.patch",
                        "patches/0009-fix-appdata.patch"
                    ]
                },
                {
                    "type": "shell",
                    "commands": [
                        "ln -s /usr/bin/python3 /app/bin/python"
                    ]
                }
            ]
        }
    ]
}
